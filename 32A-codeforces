import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int d = sc.nextInt();

        int[] arr = new int[n];

        // Input heights
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int count = 0;

        // Check every pair
        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (i != j && Math.abs(arr[i] - arr[j]) <= d) {
                    count++;
                }

            }
        }

        System.out.println(count);
    }
}
