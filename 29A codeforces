import java.util.*;
import java.math.BigInteger;
 
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        int A = sc.nextInt();
        int B = sc.nextInt();
        int n = sc.nextInt();
 
        // A = 0
        if (A == 0) {
            if (B == 0) {
                System.out.println(0);
            } else {
                System.out.println("No solution");
            }
            return;
        }
 
        for (int x = -1000; x <= 1000; x++) {
 
            BigInteger X = BigInteger.valueOf(x);
 
            BigInteger power = X.pow(n);
 
            BigInteger result = power.multiply(BigInteger.valueOf(A));
 
            if (result.equals(BigInteger.valueOf(B))) {
                System.out.println(x);
                return;
            }
        }
 
        System.out.println("No solution");
    }
}
